<!--
    Graphite glass — a dark lens, not a recoloured Island and not a blue wash.
    Blur lives in a matching HWND; this palette is only the ink, rim, and sheen.
    Same key set as Island.xaml and Console.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="UiFontFamily">Segoe UI Variable Text, Segoe UI, Cascadia Mono SemiLight</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- Hangs off the top edge: square where it meets the bezel, round below. -->
    <CornerRadius x:Key="PanelCornerRadius">0,0,22,22</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ChipCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="CodeCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="CountChipCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">13</CornerRadius>
    <Thickness x:Key="PanelPaddingThickness">8,0,8,8</Thickness>

    <!-- Dark glass fill. Blur HWND is gone: it always painted a rectangle around the pill. -->
    <SolidColorBrush x:Key="PanelBgBrush" Color="#E218181C"/>
    <SolidColorBrush x:Key="PanelShadowCasterBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#3DFFFFFF"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="CodeBgBrush" Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="RowSeparatorBrush" Color="#18FFFFFF"/>
    <SolidColorBrush x:Key="SessionRowBgBrush" Color="#00000000"/>
    <Thickness x:Key="SessionRowBorderThickness">0,0,0,1</Thickness>
    <Thickness x:Key="SessionRowPadding">12,10,12,9</Thickness>
    <Thickness x:Key="SessionRowMargin">0</Thickness>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF5F5F7"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFC7C7CC"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF8E8E93"/>

    <SolidColorBrush x:Key="AccentAmberBrush" Color="#FFFFB340"/>
    <SolidColorBrush x:Key="AccentYellowBrush" Color="#FFFFD60A"/>
    <SolidColorBrush x:Key="AccentOrangeBrush" Color="#FFFF9F0A"/>
    <SolidColorBrush x:Key="AccentTealBrush" Color="#FF64D2FF"/>
    <SolidColorBrush x:Key="AccentGreenBrush" Color="#FF30D158"/>
    <SolidColorBrush x:Key="AccentRedBrush" Color="#FFFF453A"/>

    <SolidColorBrush x:Key="StatusWorkingBrush" Color="#FF64D2FF"/>
    <SolidColorBrush x:Key="StatusNeedsYouBrush" Color="#FFFF9F0A"/>
    <SolidColorBrush x:Key="StatusFinishedBrush" Color="#FF30D158"/>
    <SolidColorBrush x:Key="StatusPromptBrush" Color="#FFFF9F0A"/>
    <SolidColorBrush x:Key="StatusIdleBrush" Color="#FF8E8E93"/>

    <SolidColorBrush x:Key="DiffAddBgBrush" Color="#2630D158"/>
    <SolidColorBrush x:Key="DiffDelBgBrush" Color="#26FF453A"/>
    <SolidColorBrush x:Key="DiffGutterBrush" Color="#FF8E8E93"/>

    <SolidColorBrush x:Key="BtnDenyBgBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="BtnDenyBorderBrush" Color="#28FFFFFF"/>
    <SolidColorBrush x:Key="BtnDenyHoverBrush" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="BtnDenyPressedBrush" Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="BtnAllowBgBrush" Color="#FFF5F5F7"/>
    <SolidColorBrush x:Key="BtnAllowHoverBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="BtnAllowPressedBrush" Color="#FFD1D1D6"/>
    <SolidColorBrush x:Key="BtnAllowFgBrush" Color="#FF1C1C1E"/>

    <SolidColorBrush x:Key="KbdBgBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="KbdBorderBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="KbdOnLightBgBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="KbdOnLightBorderBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="KbdOnLightFgBrush" Color="#FF3A3A3C"/>

    <SolidColorBrush x:Key="OptionBgBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="OptionHoverBrush" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="OptionPressedBrush" Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="SegmentCheckedBgBrush" Color="#F2F5F5F7"/>
    <SolidColorBrush x:Key="SegmentCheckedFgBrush" Color="#FF1C1C1E"/>

    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#3DFFFFFF"/>

    <SolidColorBrush x:Key="AgentClaudeBrush" Color="#FFFF9F0A"/>
    <SolidColorBrush x:Key="AgentCodexBrush" Color="#FFF5F5F7"/>
    <SolidColorBrush x:Key="AgentAntigravityBrush" Color="#FF64D2FF"/>
    <SolidColorBrush x:Key="AgentCursorBrush" Color="#FF30D158"/>
    <SolidColorBrush x:Key="AgentGenericBrush" Color="#FFC7C7CC"/>

    <SolidColorBrush x:Key="AccentYouBrush" Color="#FFFF9F0A"/>

    <SolidColorBrush x:Key="TextBrightBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#FFD1D1D6"/>
    <SolidColorBrush x:Key="TextFaintBrush" Color="#FF636366"/>

    <SolidColorBrush x:Key="InnerRuleBrush" Color="#18FFFFFF"/>
    <SolidColorBrush x:Key="KickerBgBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="RowWaitingBrush" Color="#14FFFFFF"/>

    <SolidColorBrush x:Key="SuccessTextBrush" Color="#FF30D158"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FFFF453A"/>

    <!-- ===================== Brutalist chrome (Atari only) =====================
         Declared as no-ops so every palette carries the same keys: no hard shadow,
         today's outline widths, bare marks. -->
    <SolidColorBrush x:Key="HardShadowBrush" Color="#00000000"/>
    <Thickness x:Key="HardShadowOffset">0</Thickness>
    <Thickness x:Key="CardBorderThickness">1</Thickness>
    <Thickness x:Key="OutlineThickness">0</Thickness>
    <Thickness x:Key="PanelBorderThickness">1,0,1,1</Thickness>
    <Visibility x:Key="TiledVisibility">Collapsed</Visibility>
    <Visibility x:Key="BareVisibility">Visible</Visibility>
    <Thickness x:Key="CountItemMargin">11,0,0,0</Thickness>
    <FontWeight x:Key="TitleFontWeight">Normal</FontWeight>

</ResourceDictionary>
