<!--
    Atari — soft neo-brutalism, the one light skin. Grey paper, white cards, and
    every surface drawn the same way: a 2px ink outline and a HARD offset shadow —
    solid ink shifted 3px down-right, no blur. Saturated flat colour is used as a
    FILL with black ink on top (state-coloured tiles behind the agent marks,
    state-coloured count badges, a mustard primary button), never as text on grey.
    Type is Montserrat: a wide geometric grotesque, bold where things are named.

    The hard shadow is a second element behind each surface (HardShadowBrush +
    HardShadowOffset), not a DropShadowEffect: effects rasterise on the CPU on this
    layered window, a solid Border costs nothing. The panel's own shadow is the
    shared caster shifted by a RenderTransform (see OverlayWindow.xaml).

    Because it is light, two things invert against the other palettes and must stay
    inverted: hover states go darker/warmer than their surface, and the Kbd*OnLight*
    chips — the ones that sit on the primary button — take dark ink.

    Palette + shape/type tokens only; every style lives in UI/Theme.xaml and reaches
    these keys through DynamicResource. Must declare the SAME key set as the other
    palettes — ThemeTests pins that.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== Fonts ===================== -->
    <FontFamily x:Key="UiFontFamily">Montserrat, Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- ===================== Shape ===================== -->
    <!-- Rounded rectangles, not capsules: ~10px on cards, a touch less on controls. -->
    <CornerRadius x:Key="PanelCornerRadius">0,0,16,16</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">11</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">9</CornerRadius>
    <CornerRadius x:Key="ChipCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="CodeCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="CountChipCornerRadius">5</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">11</CornerRadius>
    <Thickness x:Key="PanelPaddingThickness">8,0,8,8</Thickness>

    <!-- ===================== Surfaces ===================== -->
    <SolidColorBrush x:Key="PanelBgBrush" Color="#FFEFEFF1"/>
    <!-- The caster IS the panel's hard shadow here: solid ink, shifted, unblurred. -->
    <SolidColorBrush x:Key="PanelShadowCasterBrush" Color="#FF141414"/>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#FF141414"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#FF141414"/>
    <!-- Hover warms to a mustard wash: a lighter hover is invisible on white. -->
    <SolidColorBrush x:Key="CardHoverBrush" Color="#FFFFF4CC"/>
    <SolidColorBrush x:Key="CodeBgBrush" Color="#FFF4F4F6"/>
    <!-- Session rows are cards: white, fully outlined, spaced for their shadow. -->
    <SolidColorBrush x:Key="RowSeparatorBrush" Color="#FF141414"/>
    <SolidColorBrush x:Key="SessionRowBgBrush" Color="#FFFFFFFF"/>
    <Thickness x:Key="SessionRowBorderThickness">2</Thickness>
    <Thickness x:Key="SessionRowPadding">10,8,10,8</Thickness>
    <Thickness x:Key="SessionRowMargin">0,0,3,9</Thickness>

    <!-- ===================== Ink ===================== -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF141414"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF55555C"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF8A8A91"/>

    <!-- Accents that appear AS TEXT on grey/white are the darker cuts, so they read. -->
    <SolidColorBrush x:Key="AccentAmberBrush" Color="#FFD9480F"/>
    <SolidColorBrush x:Key="AccentYellowBrush" Color="#FFB7791F"/>
    <SolidColorBrush x:Key="AccentOrangeBrush" Color="#FFE8590C"/>
    <SolidColorBrush x:Key="AccentTealBrush" Color="#FFD6336C"/>
    <SolidColorBrush x:Key="AccentGreenBrush" Color="#FF15994A"/>
    <SolidColorBrush x:Key="AccentRedBrush" Color="#FFD92D20"/>

    <!-- ===================== Status =====================
         These are FILLS here — tiles and badges with black ink on top — so they are
         the saturated reference colours: blue running, orange waiting on you,
         green done. -->
    <SolidColorBrush x:Key="StatusWorkingBrush"  Color="#FF2F6BFF"/>
    <SolidColorBrush x:Key="StatusNeedsYouBrush" Color="#FFFF6A1F"/>
    <SolidColorBrush x:Key="StatusFinishedBrush" Color="#FF1FA355"/>
    <SolidColorBrush x:Key="StatusPromptBrush"   Color="#FFFF6A1F"/>
    <SolidColorBrush x:Key="StatusIdleBrush"     Color="#FF8E8E93"/>

    <SolidColorBrush x:Key="DiffAddBgBrush" Color="#2622B45E"/>
    <SolidColorBrush x:Key="DiffDelBgBrush" Color="#26FF3B30"/>
    <SolidColorBrush x:Key="DiffGutterBrush" Color="#FF8A8A91"/>

    <!-- ===================== Buttons ===================== -->
    <!-- Deny: white block. Allow: the mustard block — the reference's "+" button. -->
    <SolidColorBrush x:Key="BtnDenyBgBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="BtnDenyBorderBrush" Color="#FF141414"/>
    <SolidColorBrush x:Key="BtnDenyHoverBrush" Color="#FFF1F1F3"/>
    <SolidColorBrush x:Key="BtnDenyPressedBrush" Color="#FFE4E4E8"/>
    <SolidColorBrush x:Key="BtnAllowBgBrush" Color="#FFFFC933"/>
    <SolidColorBrush x:Key="BtnAllowHoverBrush" Color="#FFFFD65C"/>
    <SolidColorBrush x:Key="BtnAllowPressedBrush" Color="#FFF0B90F"/>
    <SolidColorBrush x:Key="BtnAllowFgBrush" Color="#FF141414"/>

    <SolidColorBrush x:Key="KbdBgBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="KbdBorderBrush" Color="#FF141414"/>
    <!-- These sit on the mustard Allow block, so they take dark ink. -->
    <SolidColorBrush x:Key="KbdOnLightBgBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="KbdOnLightBorderBrush" Color="#80141414"/>
    <SolidColorBrush x:Key="KbdOnLightFgBrush" Color="#FF141414"/>

    <SolidColorBrush x:Key="OptionBgBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="OptionHoverBrush" Color="#FFFFF4CC"/>
    <SolidColorBrush x:Key="OptionPressedBrush" Color="#FFFFE9A3"/>
    <!-- The picked segment is the mustard block with black ink. -->
    <SolidColorBrush x:Key="SegmentCheckedBgBrush" Color="#FFFFC933"/>
    <SolidColorBrush x:Key="SegmentCheckedFgBrush" Color="#FF141414"/>

    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#55141414"/>

    <!-- Agent identity (the console tree reads these; the island layout colours by state). -->
    <SolidColorBrush x:Key="AgentClaudeBrush" Color="#FFF26522"/>
    <SolidColorBrush x:Key="AgentCodexBrush" Color="#FF141414"/>
    <SolidColorBrush x:Key="AgentAntigravityBrush" Color="#FF2F6BFF"/>
    <SolidColorBrush x:Key="AgentCursorBrush" Color="#FFD6336C"/>
    <SolidColorBrush x:Key="AgentGenericBrush" Color="#FF8E8E93"/>

    <!-- Reserved: only ever means "blocked on you". -->
    <SolidColorBrush x:Key="AccentYouBrush" Color="#FFFF6A1F"/>

    <!-- On paper the "bright" end of the type ramp is the darkest ink. -->
    <SolidColorBrush x:Key="TextBrightBrush" Color="#FF000000"/>
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#FF2C2C30"/>
    <SolidColorBrush x:Key="TextFaintBrush" Color="#FFB4B4BA"/>

    <SolidColorBrush x:Key="InnerRuleBrush" Color="#26141414"/>
    <SolidColorBrush x:Key="KickerBgBrush" Color="#FFFFF4CC"/>
    <SolidColorBrush x:Key="RowWaitingBrush" Color="#FFFFE8DC"/>

    <SolidColorBrush x:Key="SuccessTextBrush" Color="#FF15803D"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FFC0271C"/>

    <!-- ===================== Brutalist chrome =====================
         The tokens only this skin turns on. Every other palette declares them as
         no-ops (transparent shadow, zero offset, bare marks), so the shared views
         stay identical there. -->
    <SolidColorBrush x:Key="HardShadowBrush" Color="#FF141414"/>
    <Thickness x:Key="HardShadowOffset">3,3,-3,-3</Thickness>
    <Thickness x:Key="CardBorderThickness">2</Thickness>
    <!-- Surfaces that have no outline elsewhere (Allow, options, toggle, pickers). -->
    <Thickness x:Key="OutlineThickness">2</Thickness>
    <Thickness x:Key="PanelBorderThickness">2,0,2,2</Thickness>
    <!-- Agent marks and counts sit on state-coloured tiles instead of being tinted. -->
    <Visibility x:Key="TiledVisibility">Visible</Visibility>
    <Visibility x:Key="BareVisibility">Collapsed</Visibility>
    <Thickness x:Key="CountItemMargin">6,0,0,0</Thickness>
    <FontWeight x:Key="TitleFontWeight">Bold</FontWeight>

    <!-- Panel shadow: no blur at all — the caster is solid ink shifted 4px down-right,
         which is the hard shadow. No Effect also makes this the cheapest to draw on
         the layered window. -->
    <x:Null x:Key="PanelShadowEffect"/>
    <TranslateTransform x:Key="PanelShadowTransform" X="4" Y="4"/>

    <!-- Ink ON a colour fill (tile icons, count badges). Black on both Ataris,
         independent of the text colour, so the dark skin keeps black-on-colour. -->
    <SolidColorBrush x:Key="TileInkBrush" Color="#FF141414"/>

    <!-- Toggle knob inset: the 2px track outline leaves 18px inside, so 1px
         all round keeps the end gaps equal to the top/bottom ones. -->
    <Thickness x:Key="ToggleKnobInset">1</Thickness>

</ResourceDictionary>
