<!--
    Console — the "TUI that escaped the terminal" direction from the AgentNotch
    Console design doc. Pure black, square corners everywhere, monospace for every
    label, hairline rules instead of card fills, and colour used as INK (text and
    marks) rather than as a fill. Emphasis is inverse video: white block, black
    text.

    Same key set as Themes/Island.xaml — only the values differ. See that file for
    what each token drives.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== Fonts ===================== -->
    <!-- One grid, one face: prose gets the same mono as the numbers. -->
    <FontFamily x:Key="UiFontFamily">Cascadia Mono SemiLight, Cascadia Mono, JetBrains Mono, Consolas</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Cascadia Mono, JetBrains Mono, Consolas, Courier New</FontFamily>

    <!-- ===================== Shape ===================== -->
    <!-- "no cards, no pills, no rounded corners" — every radius is zero. -->
    <CornerRadius x:Key="PanelCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="ChipCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="CodeCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="CountChipCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">0</CornerRadius>
    <!-- The console panel has no inset of its own: every block inside it
         carries the design's own 12px gutter. -->
    <Thickness x:Key="PanelPaddingThickness">0</Thickness>

    <!-- ===================== Palette ===================== -->
    <SolidColorBrush x:Key="PanelBgBrush" Color="#FA000000"/>
    <SolidColorBrush x:Key="PanelShadowCasterBrush" Color="#FA000000"/>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#FF262626"/>
    <!-- Cards are the same black as the panel; the hairline is what separates them. -->
    <SolidColorBrush x:Key="CardBgBrush" Color="#FF000000"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#FF1C1C1C"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#FF101010"/>
    <SolidColorBrush x:Key="CodeBgBrush" Color="#FF000000"/>
    <SolidColorBrush x:Key="RowSeparatorBrush" Color="#FF131313"/>
    <SolidColorBrush x:Key="SessionRowBgBrush" Color="#00000000"/>
    <Thickness x:Key="SessionRowBorderThickness">0,0,0,1</Thickness>
    <Thickness x:Key="SessionRowPadding">10,7,10,6</Thickness>
    <Thickness x:Key="SessionRowMargin">0,2,0,0</Thickness>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFE4E4E4"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF8E8E8E"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF5E5E5E"/>

    <SolidColorBrush x:Key="AccentAmberBrush" Color="#FFE8814A"/>
    <SolidColorBrush x:Key="AccentYellowBrush" Color="#FFE8C24A"/>
    <SolidColorBrush x:Key="AccentOrangeBrush" Color="#FFE8814A"/>
    <SolidColorBrush x:Key="AccentTealBrush" Color="#FF6EE7D7"/>
    <SolidColorBrush x:Key="AccentGreenBrush" Color="#FF3DDC84"/>
    <SolidColorBrush x:Key="AccentRedBrush" Color="#FFFF5C4D"/>

    <!-- ===================== Status palette ===================== -->
    <SolidColorBrush x:Key="StatusWorkingBrush"  Color="#FF4E8CF7"/> <!-- blue   · running now      -->
    <SolidColorBrush x:Key="StatusNeedsYouBrush" Color="#FFFFB020"/> <!-- orange · a question waits  -->
    <SolidColorBrush x:Key="StatusFinishedBrush" Color="#FF3DDC84"/> <!-- green  · finished, done    -->
    <SolidColorBrush x:Key="StatusPromptBrush"   Color="#FFFFB020"/> <!-- orange · approval blocking-->
    <SolidColorBrush x:Key="StatusIdleBrush"     Color="#FF5E5E5E"/> <!-- grey   · nothing running  -->

    <SolidColorBrush x:Key="DiffAddBgBrush" Color="#143DDC84"/>
    <SolidColorBrush x:Key="DiffDelBgBrush" Color="#14FF5C4D"/>
    <SolidColorBrush x:Key="DiffGutterBrush" Color="#FF3A3A3A"/>

    <!-- Deny is an outline, allow is inverse video — the doc's only two button weights. -->
    <SolidColorBrush x:Key="BtnDenyBgBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="BtnDenyBorderBrush" Color="#FF2E2E2E"/>
    <SolidColorBrush x:Key="BtnDenyHoverBrush" Color="#FF1A0B08"/>
    <SolidColorBrush x:Key="BtnDenyPressedBrush" Color="#FF25100C"/>
    <SolidColorBrush x:Key="BtnAllowBgBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="BtnAllowHoverBrush" Color="#FFD4D4D4"/>
    <SolidColorBrush x:Key="BtnAllowPressedBrush" Color="#FFB4B4B4"/>
    <SolidColorBrush x:Key="BtnAllowFgBrush" Color="#FF000000"/>

    <SolidColorBrush x:Key="KbdBgBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="KbdBorderBrush" Color="#FF2E2E2E"/>
    <SolidColorBrush x:Key="KbdOnLightBgBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="KbdOnLightBorderBrush" Color="#33000000"/>
    <SolidColorBrush x:Key="KbdOnLightFgBrush" Color="#FF3A3A3A"/>

    <SolidColorBrush x:Key="OptionBgBrush" Color="#FF0B0B0B"/>
    <SolidColorBrush x:Key="OptionHoverBrush" Color="#FF141414"/>
    <SolidColorBrush x:Key="OptionPressedBrush" Color="#FF1F1F1F"/>
    <!-- Inverse video is the only emphasis: the picked segment is a white block. -->
    <SolidColorBrush x:Key="SegmentCheckedBgBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SegmentCheckedFgBrush" Color="#FF000000"/>

    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#FF2E2E2E"/>

    <!-- ===================== Agent identity =====================
         Colour is identity, not status: it inks the agent's own mark and name and
         never fills a background. -->
    <SolidColorBrush x:Key="AgentClaudeBrush" Color="#FFE8814A"/>
    <SolidColorBrush x:Key="AgentCodexBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="AgentAntigravityBrush" Color="#FF4E8CF7"/>
    <SolidColorBrush x:Key="AgentCursorBrush" Color="#FF6EE7D7"/>
    <SolidColorBrush x:Key="AgentGenericBrush" Color="#FF8E8E8E"/>

    <!-- Reserved: amber ONLY ever means "blocked on you". Nothing else may use it. -->
    <SolidColorBrush x:Key="AccentYouBrush" Color="#FFFFB020"/>

    <SolidColorBrush x:Key="TextBrightBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#FFD4D4D4"/>
    <SolidColorBrush x:Key="TextFaintBrush" Color="#FF3A3A3A"/>

    <SolidColorBrush x:Key="InnerRuleBrush" Color="#FF1C1C1C"/>
    <SolidColorBrush x:Key="KickerBgBrush" Color="#FF101010"/>
    <SolidColorBrush x:Key="RowWaitingBrush" Color="#FF141414"/>

    <SolidColorBrush x:Key="SuccessTextBrush" Color="#FF5FE39C"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FFFF7B6D"/>

</ResourceDictionary>
