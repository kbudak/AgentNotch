<UserControl x:Class="AgentNotch.App.UI.PixelSpinner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <!-- 12 pixel dots on a ring. Nothing moves: each dot's opacity fades from full to
         dim on the same 0.9s loop, staggered by cycle/12, so a bright head glides
         around the ring with a smooth fading tail. Dots never move -> crisp pixels;
         motion is pure opacity -> fluid. Fill follows the control's Foreground. -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="24" Height="24">
            <Canvas.Resources>
                <Style TargetType="{x:Type Rectangle}">
                    <Setter Property="Width" Value="2.8"/>
                    <Setter Property="Height" Value="2.8"/>
                    <Setter Property="Fill"
                            Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                </Style>
            </Canvas.Resources>
            <Rectangle x:Name="d0"  Canvas.Left="10.6"  Canvas.Top="2.6"/>
            <Rectangle x:Name="d1"  Canvas.Left="14.6"  Canvas.Top="3.67"/>
            <Rectangle x:Name="d2"  Canvas.Left="17.53" Canvas.Top="6.6"/>
            <Rectangle x:Name="d3"  Canvas.Left="18.6"  Canvas.Top="10.6"/>
            <Rectangle x:Name="d4"  Canvas.Left="17.53" Canvas.Top="14.6"/>
            <Rectangle x:Name="d5"  Canvas.Left="14.6"  Canvas.Top="17.53"/>
            <Rectangle x:Name="d6"  Canvas.Left="10.6"  Canvas.Top="18.6"/>
            <Rectangle x:Name="d7"  Canvas.Left="6.6"   Canvas.Top="17.53"/>
            <Rectangle x:Name="d8"  Canvas.Left="3.67"  Canvas.Top="14.6"/>
            <Rectangle x:Name="d9"  Canvas.Left="2.6"   Canvas.Top="10.6"/>
            <Rectangle x:Name="d10" Canvas.Left="3.67"  Canvas.Top="6.6"/>
            <Rectangle x:Name="d11" Canvas.Left="6.6"   Canvas.Top="3.67"/>
        </Canvas>
    </Viewbox>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="d0"  Storyboard.TargetProperty="Opacity" From="1" To="0.13" Duration="0:0:0.9" BeginTime="0:0:0.000"  RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="d1"  Storyboard.TargetProperty="Opacity" From="1" To="0.13" Duration="0:0:0.9" BeginTime="0:0:0.075"  RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="d2"  Storyboard.TargetProperty="Opacity" From="1" To="0.13" Duration="0:0:0.9" BeginTime="0:0:0.150"  RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="d3"  Storyboard.TargetProperty="Opacity" From="1" To="0.13" Duration="0:0:0.9" BeginTime="0:0:0.225"  RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="d4"  Storyboard.TargetProperty="Opacity" From="1" To="0.13" Duration="0:0:0.9" BeginTime="0:0:0.300"  RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="d5"  Storyboard.TargetProperty="Opacity" From="1" To="0.13" Duration="0:0:0.9" BeginTime="0:0:0.375"  RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="d6"  Storyboard.TargetProperty="Opacity" From="1" To="0.13" Duration="0:0:0.9" BeginTime="0:0:0.450"  RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="d7"  Storyboard.TargetProperty="Opacity" From="1" To="0.13" Duration="0:0:0.9" BeginTime="0:0:0.525"  RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="d8"  Storyboard.TargetProperty="Opacity" From="1" To="0.13" Duration="0:0:0.9" BeginTime="0:0:0.600"  RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="d9"  Storyboard.TargetProperty="Opacity" From="1" To="0.13" Duration="0:0:0.9" BeginTime="0:0:0.675"  RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="d10" Storyboard.TargetProperty="Opacity" From="1" To="0.13" Duration="0:0:0.9" BeginTime="0:0:0.750"  RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="d11" Storyboard.TargetProperty="Opacity" From="1" To="0.13" Duration="0:0:0.9" BeginTime="0:0:0.825"  RepeatBehavior="Forever"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>
