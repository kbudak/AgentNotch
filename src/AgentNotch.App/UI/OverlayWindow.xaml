<Window x:Class="AgentNotch.App.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AgentNotch.App.UI"
        Title="AgentNotch"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Width="640" Height="120"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="12.5"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <!-- Fixed-size fully transparent window: the HWND never resizes, so the
         expand/collapse animation happens purely in composition (no per-frame
         window resizing = no jank). Null background keeps empty areas
         click-through and hover-transparent; only the panel is interactive. -->
    <Grid Margin="28,0,28,32" HorizontalAlignment="Center" VerticalAlignment="Top">

        <!-- Shadow layer: same shape, effect applied here so text above stays crisp. -->
        <Border Background="{DynamicResource PanelBgBrush}"
                CornerRadius="{DynamicResource PanelCornerRadius}">
            <Border.Effect>
                <DropShadowEffect Color="#FF000000" Opacity="0.4" BlurRadius="24" ShadowDepth="8" Direction="270"/>
            </Border.Effect>
        </Border>

        <!-- Notch panel — Width is animated from code-behind (248 pill ⇄ 576 open). -->
        <Border x:Name="NotchPanel"
                Width="248"
                Background="{DynamicResource PanelBgBrush}"
                BorderThickness="1,0,1,1"
                CornerRadius="{DynamicResource PanelCornerRadius}"
                Padding="{DynamicResource PanelPaddingThickness}">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
                    <Style.Triggers>
                        <!-- Console only: the collapsed line's edge turns amber when
                             something is blocked on you. Never during a confirmation
                             flash, and never while the panel is open. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Theme}" Value="console"/>
                                <Condition Binding="{Binding BlockedOnYou}" Value="True"/>
                                <Condition Binding="{Binding IsExpanded}" Value="False"/>
                                <Condition Binding="{Binding HasToast}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentYouBrush}"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>

                <!-- ============ Top header + collapsed pill (island) ============ -->
                <Grid MinWidth="210"
                      Visibility="{Binding Theme, Converter={StaticResource ThemeVisibility}, ConverterParameter=island}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0 (expanded only): plan limits at the top-left, gear at the
                         top-right — above the agent icon / status line. -->
                    <Grid Grid.Row="0" Margin="14,7,10,0"
                          Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ItemsControl Grid.Column="0" ItemsSource="{Binding Usage}" Focusable="False"
                                      VerticalAlignment="Center"
                                      Visibility="{Binding ShowUsage, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                        <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding PercentText}" FontSize="11" Margin="5,0,0,0"
                                                   FontFamily="{DynamicResource MonoFontFamily}"
                                                   Foreground="{Binding UsedPct, Converter={StaticResource UsageSeverityBrush}}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ResetText}" FontSize="11" Margin="5,0,0,0"
                                                   FontFamily="{DynamicResource MonoFontFamily}"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}" Click="OnSettingsClick"
                                VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Path Data="{x:Static ui:AgentIcons.Gear}" Width="14" Height="14" Stretch="Uniform"
                                  Fill="{DynamicResource TextSecondaryBrush}"/>
                        </Button>
                    </Grid>

                    <!-- Confirmation of what the notch just sent back; replaces the
                         normal pill content for a couple of seconds. Deliberately
                         undecorated — no capsule, no badge, no background: a glyph and
                         one line in the kind's colour IS the message. The colour and
                         the glyph already say allowed / denied / handed back, so
                         nothing else has to. -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Height="30" Margin="0,5,0,0"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasToast, Converter={StaticResource BoolToVis}}">
                        <StackPanel.Style>
                            <Style TargetType="{x:Type StackPanel}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasToast}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0" To="1" Duration="0:0:0.18"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="{Binding ToastKind, Converter={StaticResource ToastGlyph}}"
                                   FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"
                                   Foreground="{Binding ToastKind, Converter={StaticResource ToastBrush}}"/>
                        <TextBlock Text="{Binding ToastText}" Margin="7,0,0,0"
                                   FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{Binding ToastKind, Converter={StaticResource ToastBrush}}"/>
                        <!-- Same colour, dimmed: what it applied to, without a second style. -->
                        <TextBlock Text="{Binding ToastDetail}" Margin="6,0,0,0" Opacity="0.6"
                                   FontSize="12.5" VerticalAlignment="Center"
                                   MaxWidth="300" TextTrimming="CharacterEllipsis"
                                   Foreground="{Binding ToastKind, Converter={StaticResource ToastBrush}}"
                                   Visibility="{Binding ToastDetail, Converter={StaticResource StringToVisibility}}"/>
                    </StackPanel>

                    <!-- Status summary — only while collapsed; once expanded the session
                         list below shows every status, so this would just repeat it. -->
                    <!-- Marks pinned left, wording pinned right: the pill reads as a
                         status bar rather than a loose huddle in the middle. -->
                    <Grid Grid.Row="1" Height="30" Margin="14,0,14,0">
                        <Grid.Style>
                            <Style TargetType="{x:Type Grid}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasToast}" Value="False"/>
                                            <Condition Binding="{Binding IsExpanded}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                        <!-- Lead agent mark (shape = which agent) tinted by state colour. -->
                        <Path Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"
                              Data="{Binding LeadAgent, Converter={StaticResource AgentIcon}}"
                              Fill="{Binding StateKind, Converter={StaticResource StateKindBrush}, FallbackValue=#FF6B7280}"/>
                        <!-- Status glyph to its right: working = pixel comet spinner,
                             needs-you = "?", prompt = "?", done = "✓"; the whole slot is
                             hidden when idle so nothing but the grey dot shows. -->
                        <Grid Width="12" Height="12" Margin="6,0,0,0" VerticalAlignment="Center"
                              Visibility="{Binding StateKind, Converter={StaticResource StateVisibility}, ConverterParameter=!idle}">
                            <ui:PixelSpinner
                                Foreground="{Binding StateKind, Converter={StaticResource StateKindBrush}, FallbackValue=#FF6B7280}"
                                Visibility="{Binding StateKind, Converter={StaticResource StateVisibility}, ConverterParameter=working}"/>
                            <Path Stretch="Uniform"
                                  Data="{Binding StateKind, Converter={StaticResource StateKindIcon}}"
                                  Fill="{Binding StateKind, Converter={StaticResource StateKindBrush}, FallbackValue=#FF6B7280}">
                                <Path.Style>
                                    <Style TargetType="{x:Type Path}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StateKind, FallbackValue=idle}" Value="finished">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StateKind, FallbackValue=idle}" Value="needsyou">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="PillPulseNeedsYou">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="1" To="0.3" Duration="0:0:0.6"
                                                                             AutoReverse="True" RepeatBehavior="Forever"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="PillPulseNeedsYou"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StateKind, FallbackValue=idle}" Value="prompt">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="PillPulsePrompt">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="1" To="0.25" Duration="0:0:0.45"
                                                                             AutoReverse="True" RepeatBehavior="Forever"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="PillPulsePrompt"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Grid>
                        </StackPanel>

                        <!-- Right-aligned summary. The count carries its state's colour
                             and the word stays white, so two segments separate on sight
                             instead of needing a dot between them. -->
                        <ItemsControl ItemsSource="{Binding CollapsedParts}" Focusable="False"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Margin="12,0,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Dot + count, no container. The chip's tinted box was
                                         drawing more attention than the agent marks it sits
                                         next to; a 6px dot carries the state colour just as
                                         well and the number can then be plain text.
                                         The pip takes the theme's radius, so it is a dot on
                                         the island and a square pip on the console. -->
                                    <StackPanel Orientation="Horizontal" Margin="11,0,0,0"
                                                VerticalAlignment="Center">
                                        <Border Width="6" Height="6" VerticalAlignment="Center"
                                                CornerRadius="{DynamicResource CountChipCornerRadius}"
                                                Background="{Binding Kind, Converter={StaticResource StateKindBrush}}"/>
                                        <!-- Nudged down 1px. Box-centring lines the digit's
                                             INK centroid up with the dot, but "1" in Cascadia
                                             carries a wide base serif that drags that centroid
                                             below where the eye reads the glyph's middle, so
                                             the dot looked high. A render transform, not a
                                             margin, so it shifts by exactly 1px instead of
                                             being halved by the centring. -->
                                        <TextBlock Text="{Binding Count}" Margin="5,0,0,0"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}">
                                            <TextBlock.RenderTransform>
                                                <TranslateTransform Y="1"/>
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>


                <!-- ============ Collapsed status line (console) ============
                     When collapsed the panel IS the line: 26px tall, wearing the
                     panel's own black and hairline edge, segments split by
                     full-height rules. No quota, no chevron, no hover hint — the
                     spec cut all three as noise; do not re-add them. -->
                <Grid x:Name="ConsoleLine" Height="26" HorizontalAlignment="Left">
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Theme}" Value="console"/>
                                        <Condition Binding="{Binding IsExpanded}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <!-- Confirmation flash: centred, 40px of air either side, the
                         kind's colour and nothing else. -->
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,0"
                               FontSize="11.5" FontWeight="Bold"
                               Foreground="{Binding ToastKind, Converter={StaticResource ToastBrush}}"
                               Visibility="{Binding HasToast, Converter={StaticResource BoolToVis}}">
                        <Run Text="{Binding ToastKind, Converter={StaticResource ToastGlyph}, Mode=OneWay}"/>
                        <Run Text="{Binding ToastText, Mode=OneWay}"/>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                Visibility="{Binding HasToast, Converter={StaticResource BoolToCollapsed}}">
                        <StackPanel Orientation="Horizontal" Margin="11,0" VerticalAlignment="Center">
                            <TextBlock FontSize="10" VerticalAlignment="Center"
                                       Text="{Binding ShellState, Converter={StaticResource ShellGlyph}}"
                                       Foreground="{Binding ShellState, Converter={StaticResource ShellInk}}">
                                <TextBlock.Triggers>
                                    <EventTrigger RoutedEvent="TextBlock.Loaded">
                                        <BeginStoryboard>
                                            <!-- 20fps: layered window, every frame is a CPU blit. -->
                                            <Storyboard Timeline.DesiredFrameRate="20">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0.25" Duration="0:0:0.8"
                                                                 AutoReverse="True" RepeatBehavior="Forever"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </TextBlock.Triggers>
                            </TextBlock>
                            <TextBlock Text="{Binding Headline}" FontSize="11.5" Margin="7,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding ShellState, Converter={StaticResource ShellInk}}"/>
                        </StackPanel>

                        <Border Width="1" Background="{DynamicResource PanelBorderBrush}"
                                Visibility="{Binding AgentMarks, Converter={StaticResource CollectionToVisibility}}"/>

                        <ItemsControl ItemsSource="{Binding AgentMarks}" Focusable="False"
                                      Margin="6,0,11,0" VerticalAlignment="Center"
                                      Visibility="{Binding AgentMarks, Converter={StaticResource CollectionToVisibility}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- The spec's 6x6 swatch, drawn as the agent's own mark:
                                         it still reads as a coloured tick at this size and
                                         keeps the agents recognisable at a glance. -->
                                    <Path Width="11" Height="11" Stretch="Uniform" Margin="5,0,0,0"
                                          VerticalAlignment="Center"
                                          Data="{Binding Agent, Converter={StaticResource AgentIcon}}"
                                          Fill="{Binding Agent, Converter={StaticResource AgentInk}}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <!-- ============ Expanded content ============ -->
                <!-- Curtain reveal: RevealHost's Height is animated from code-behind
                     (0 ⇄ content height) while ClipToBounds hides the rest — the content
                     itself never scales or squashes; it slides down a touch and fades.
                     Content height changes while open (prompt card swaps) are morphed. -->
                <Grid x:Name="RevealHost" ClipToBounds="True" Height="0" Visibility="Collapsed">
                    <StackPanel x:Name="ExpandedContent"
                                VerticalAlignment="Top" HorizontalAlignment="Center"
                                Opacity="0">

                    <!-- Island body. The console body is a sibling below it; only one
                         is ever visible, and a Collapsed subtree is skipped by both
                         layout and render. -->
                    <StackPanel Width="560"
                                Visibility="{Binding Theme, Converter={StaticResource ThemeVisibility}, ConverterParameter=island}">

                    <!-- Plan limits now live in the pill header (top line); nothing here. -->

                    <!-- Settings flyout (gear-toggled) -->
                    <Border Margin="4,8,4,0" Padding="14,12"
                            Background="{DynamicResource CardBgBrush}"
                            BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource CardCornerRadius}"
                            Visibility="{Binding SettingsOpen, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="SETTINGS" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,10"/>

                            <!-- Launch at login -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Launch at login" FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Start AgentNotch when Windows starts" FontSize="11"
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" VerticalAlignment="Center"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              IsChecked="{Binding LaunchAtLogin, Mode=TwoWay}"/>
                            </Grid>

                            <!-- Show usage limits -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Show usage limits" FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Display the 5h / 7d plan usage row" FontSize="11"
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </StackPanel>
                                <ToggleButton Grid.Column="1" VerticalAlignment="Center"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              IsChecked="{Binding ShowUsage, Mode=TwoWay}"/>
                            </Grid>

                            <!-- Theme -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Theme" FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Rounded island, or the square console" FontSize="11"
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </StackPanel>
                                <Border Grid.Column="1" VerticalAlignment="Center"
                                        Background="{DynamicResource OptionBgBrush}"
                                        CornerRadius="{DynamicResource ButtonCornerRadius}" Padding="2">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton GroupName="notchtheme" Content="Island"
                                                     Style="{StaticResource SegmentRadioStyle}"
                                                     IsChecked="{Binding Theme, Converter={StaticResource EqualsParam}, ConverterParameter=island, Mode=TwoWay}"/>
                                        <RadioButton GroupName="notchtheme" Content="Console"
                                                     Style="{StaticResource SegmentRadioStyle}"
                                                     IsChecked="{Binding Theme, Converter={StaticResource EqualsParam}, ConverterParameter=console, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Position -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Notch position" FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Where it sits along the top edge" FontSize="11"
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </StackPanel>
                                <Border Grid.Column="1" VerticalAlignment="Center"
                                        Background="{DynamicResource OptionBgBrush}" CornerRadius="{DynamicResource ButtonCornerRadius}" Padding="2">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton GroupName="notchpos" Content="Left"
                                                     Style="{StaticResource SegmentRadioStyle}"
                                                     IsChecked="{Binding Position, Converter={StaticResource EqualsParam}, ConverterParameter=left, Mode=TwoWay}"/>
                                        <RadioButton GroupName="notchpos" Content="Center"
                                                     Style="{StaticResource SegmentRadioStyle}"
                                                     IsChecked="{Binding Position, Converter={StaticResource EqualsParam}, ConverterParameter=center, Mode=TwoWay}"/>
                                        <RadioButton GroupName="notchpos" Content="Right"
                                                     Style="{StaticResource SegmentRadioStyle}"
                                                     IsChecked="{Binding Position, Converter={StaticResource EqualsParam}, ConverterParameter=right, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Prompt card (permission / question by Kind) + queue badge -->
                    <StackPanel Margin="4,6,4,0"
                                Visibility="{Binding ActivePrompt, Converter={StaticResource NullToVisibility}}">
                        <Border HorizontalAlignment="Right" Margin="0,0,2,4"
                                Background="{DynamicResource KbdBgBrush}"
                                BorderBrush="{DynamicResource KbdBorderBrush}"
                                BorderThickness="1" CornerRadius="{DynamicResource ChipCornerRadius}" Padding="6,2"
                                Visibility="{Binding QueueCount, Converter={StaticResource GreaterThanOneToVisibility}}">
                            <TextBlock Text="{Binding QueueBadgeText, FallbackValue=''}"
                                       FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                        <ContentControl Content="{Binding ActivePrompt}" Focusable="False" IsTabStop="False">
                            <ContentControl.Style>
                                <Style TargetType="{x:Type ContentControl}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActivePrompt.Kind}" Value="Permission">
                                            <Setter Property="ContentTemplate">
                                                <Setter.Value>
                                                    <DataTemplate>
                                                        <ui:PermissionPromptView/>
                                                    </DataTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActivePrompt.Kind}" Value="Question">
                                            <Setter Property="ContentTemplate">
                                                <Setter.Value>
                                                    <DataTemplate>
                                                        <ui:QuestionPromptView/>
                                                    </DataTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                    </StackPanel>

                        <!-- Sessions list (always shown while expanded) -->
                        <ui:SessionsView Margin="4,6,4,2"/>
                    </StackPanel>

                    <ui:ConsoleBodyView
                        Visibility="{Binding Theme, Converter={StaticResource ThemeVisibility}, ConverterParameter=console}"/>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </Border>
    </Grid>
</Window>
