<Window x:Class="AgentNotch.App.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AgentNotch.App.UI"
        Title="AgentNotch"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Width="640" Height="800"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="12.5"
        Foreground="{StaticResource TextPrimaryBrush}">

    <!-- Fixed-size fully transparent window: the HWND never resizes, so the
         expand/collapse animation happens purely in composition (no per-frame
         window resizing = no jank). Null background keeps empty areas
         click-through and hover-transparent; only the panel is interactive. -->
    <Grid Margin="28,0,28,32" HorizontalAlignment="Center" VerticalAlignment="Top">

        <!-- Shadow layer: same shape, effect applied here so text above stays crisp. -->
        <Border Background="{StaticResource PanelBgBrush}"
                CornerRadius="0,0,18,18">
            <Border.Effect>
                <DropShadowEffect Color="#FF000000" Opacity="0.4" BlurRadius="24" ShadowDepth="8" Direction="270"/>
            </Border.Effect>
        </Border>

        <!-- Notch panel — Width is animated from code-behind (280 pill ⇄ 576 open). -->
        <Border x:Name="NotchPanel"
                Width="280"
                Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1,0,1,1"
                CornerRadius="0,0,18,18"
                Padding="8,0,8,8">
            <StackPanel>

                <!-- ============ Collapsed pill (always visible) ============ -->
                <Grid Height="34" MinWidth="240">

                    <!-- Confirmation of what the notch just sent back; replaces the
                         normal pill content for a couple of seconds. -->
                    <TextBlock Text="{Binding ToastText}" FontSize="12.5" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{Binding ToastKind, Converter={StaticResource ToastBrush}}"
                               Visibility="{Binding HasToast, Converter={StaticResource BoolToVis}}"/>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0"
                                Visibility="{Binding HasToast, Converter={StaticResource BoolToCollapsed}}">
                        <!-- Lead state's pixel mark: shape = state (spinner / "?" / "✓"),
                             fill = that state's colour. Idle falls back to a grey dot;
                             working spins. -->
                        <Path Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5"
                              Data="{Binding StateKind, Converter={StaticResource StateKindIcon}}"
                              Fill="{Binding StateKind, Converter={StaticResource StateKindBrush}, FallbackValue=#FF6B7280}">
                            <Path.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </Path.RenderTransform>
                            <Path.Style>
                                <Style TargetType="{x:Type Path}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StateKind, FallbackValue=idle}" Value="working">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="PillPulseWorking">
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                            From="0" To="360" Duration="0:0:1.1"
                                                            RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="PillPulseWorking"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StateKind, FallbackValue=idle}" Value="needsyou">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="PillPulseNeedsYou">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="1" To="0.3" Duration="0:0:0.6"
                                                                         AutoReverse="True" RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="PillPulseNeedsYou"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StateKind, FallbackValue=idle}" Value="prompt">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="PillPulsePrompt">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="1" To="0.25" Duration="0:0:0.45"
                                                                         AutoReverse="True" RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="PillPulsePrompt"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <TextBlock Text="{Binding CollapsedText, FallbackValue=idle}"
                                   Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center"
                                   MaxWidth="200" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <!-- Active agent count (replaces the old ✦ glyph); hidden when idle.
                         Bound to Sessions.Count (not the collection itself) so the
                         ObservableCollection's Count change notifications re-evaluate it. -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,12,0" Padding="7,1"
                            Background="{StaticResource KbdBgBrush}"
                            BorderBrush="{StaticResource KbdBorderBrush}"
                            BorderThickness="1" CornerRadius="9">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Sessions.Count, FallbackValue=0}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasToast}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Sessions.Count, FallbackValue=0}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>
                </Grid>

                <!-- ============ Expanded content ============ -->
                <!-- Curtain reveal: RevealHost's Height is animated from code-behind
                     (0 ⇄ content height) while ClipToBounds hides the rest — the content
                     itself never scales or squashes; it slides down a touch and fades.
                     Content height changes while open (prompt card swaps) are morphed. -->
                <Grid x:Name="RevealHost" ClipToBounds="True" Height="0">
                    <StackPanel x:Name="ExpandedContent" Width="560"
                                VerticalAlignment="Top" HorizontalAlignment="Center"
                                Opacity="0">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="ContentSlide" Y="-14"/>
                        </StackPanel.RenderTransform>

                    <!-- Plan limits ("5h 20% 2h14m │ 7d 4% 6d14h") + settings gear -->
                    <Grid Margin="8,6,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ItemsControl Grid.Column="0" ItemsSource="{Binding Usage}" Focusable="False"
                                      VerticalAlignment="Center"
                                      Visibility="{Binding Usage, Converter={StaticResource CollectionToVisibility}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                        <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding PercentText}" FontSize="11" Margin="5,0,0,0"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   Foreground="{Binding UsedPct, Converter={StaticResource UsageSeverityBrush}}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ResetText}" FontSize="11" Margin="5,0,0,0"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   Foreground="{StaticResource TextTertiaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}"
                                Click="OnSettingsClick" Content="&#x2699;" FontSize="15"
                                VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,2,0"/>
                    </Grid>

                    <!-- Settings flyout (gear-toggled) -->
                    <Border Margin="4,8,4,0" Padding="12,10"
                            Background="{StaticResource CardBgBrush}"
                            BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                            CornerRadius="10"
                            Visibility="{Binding SettingsOpen, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="SETTINGS" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Launch at login" FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Start AgentNotch when Windows starts" FontSize="11"
                                               Foreground="{StaticResource TextTertiaryBrush}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Click="OnToggleLaunchAtLogin"
                                        VerticalAlignment="Center" Cursor="Hand"
                                        Focusable="False" IsTabStop="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border x:Name="track" Width="40" Height="22" CornerRadius="11"
                                                    Background="{StaticResource OptionBgBrush}">
                                                <Ellipse x:Name="thumb" Width="16" Height="16"
                                                         HorizontalAlignment="Left" Margin="3,0,0,0"
                                                         Fill="{StaticResource TextSecondaryBrush}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding LaunchAtLogin}" Value="True">
                                                    <Setter TargetName="track" Property="Background"
                                                            Value="{StaticResource StatusFinishedBrush}"/>
                                                    <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter TargetName="thumb" Property="Margin" Value="0,0,3,0"/>
                                                    <Setter TargetName="thumb" Property="Fill" Value="White"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Prompt card (permission / question by Kind) + queue badge -->
                    <StackPanel Margin="4,6,4,0"
                                Visibility="{Binding ActivePrompt, Converter={StaticResource NullToVisibility}}">
                        <Border HorizontalAlignment="Right" Margin="0,0,2,4"
                                Background="{StaticResource KbdBgBrush}"
                                BorderBrush="{StaticResource KbdBorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="6,2"
                                Visibility="{Binding QueueCount, Converter={StaticResource GreaterThanOneToVisibility}}">
                            <TextBlock Text="{Binding QueueBadgeText, FallbackValue=''}"
                                       FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>
                        <ContentControl Content="{Binding ActivePrompt}" Focusable="False" IsTabStop="False">
                            <ContentControl.Style>
                                <Style TargetType="{x:Type ContentControl}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActivePrompt.Kind}" Value="Permission">
                                            <Setter Property="ContentTemplate">
                                                <Setter.Value>
                                                    <DataTemplate>
                                                        <ui:PermissionPromptView/>
                                                    </DataTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ActivePrompt.Kind}" Value="Question">
                                            <Setter Property="ContentTemplate">
                                                <Setter.Value>
                                                    <DataTemplate>
                                                        <ui:QuestionPromptView/>
                                                    </DataTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                    </StackPanel>

                        <!-- Sessions list (always shown while expanded) -->
                        <ui:SessionsView Margin="4,6,4,2"/>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </Border>
    </Grid>
</Window>
