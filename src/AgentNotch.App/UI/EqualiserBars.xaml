<UserControl x:Class="AgentNotch.App.UI.EqualiserBars"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <!-- The empty state's five agent-coloured bars: each scales on Y from .3 to 1
         on the same 1.9s loop, staggered .2s apart, so the row reads as a level
         meter. Colour is agent identity, left to right, exactly as the design has
         it — this is the one place the product names its agents by colour alone. -->
    <Grid Height="14" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
            <StackPanel.Resources>
                <Style TargetType="{x:Type Rectangle}">
                    <Setter Property="Width" Value="5"/>
                    <Setter Property="Height" Value="14"/>
                    <Setter Property="Margin" Value="0,0,4,0"/>
                    <Setter Property="RenderTransformOrigin" Value="0.5,1"/>
                </Style>
            </StackPanel.Resources>
            <Rectangle x:Name="b0" Fill="{DynamicResource AgentClaudeBrush}">
                <Rectangle.RenderTransform><ScaleTransform ScaleY="1"/></Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="b1" Fill="{DynamicResource AgentCodexBrush}">
                <Rectangle.RenderTransform><ScaleTransform ScaleY="1"/></Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="b2" Fill="{DynamicResource AgentAntigravityBrush}">
                <Rectangle.RenderTransform><ScaleTransform ScaleY="1"/></Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="b3" Fill="{DynamicResource AgentCursorBrush}">
                <Rectangle.RenderTransform><ScaleTransform ScaleY="1"/></Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="b4" Margin="0" Fill="{DynamicResource AccentGreenBrush}">
                <Rectangle.RenderTransform><ScaleTransform ScaleY="1"/></Rectangle.RenderTransform>
            </Rectangle>
        </StackPanel>
    </Grid>

    <UserControl.Resources>
        <!-- 20fps: layered window, every frame is a CPU blit. Started/stopped in
             code-behind only while IsLoaded && IsVisible so non-Console themes cost 0% CPU. -->
        <Storyboard x:Key="EqualiserStoryboard" Timeline.DesiredFrameRate="20">
            <DoubleAnimation Storyboard.TargetName="b0" Storyboard.TargetProperty="RenderTransform.ScaleY"
                             From="0.3" To="1" Duration="0:0:0.95" BeginTime="0:0:0.0"
                             AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="b1" Storyboard.TargetProperty="RenderTransform.ScaleY"
                             From="0.3" To="1" Duration="0:0:0.95" BeginTime="0:0:0.2"
                             AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="b2" Storyboard.TargetProperty="RenderTransform.ScaleY"
                             From="0.3" To="1" Duration="0:0:0.95" BeginTime="0:0:0.4"
                             AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="b3" Storyboard.TargetProperty="RenderTransform.ScaleY"
                             From="0.3" To="1" Duration="0:0:0.95" BeginTime="0:0:0.6"
                             AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="b4" Storyboard.TargetProperty="RenderTransform.ScaleY"
                             From="0.3" To="1" Duration="0:0:0.95" BeginTime="0:0:0.8"
                             AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>
    </UserControl.Resources>
</UserControl>
