<!--
    Shared converters + control styles. Palettes live in Themes/*.xaml; App.xaml
    merges the active one into slot 0 and this file
    into slot 1. Every colour, font and corner radius below is a DynamicResource so
    ThemeManager can swap slot 0 at runtime and the whole notch repaints in place.
    Rule of thumb when editing: theme tokens -> DynamicResource, styles and
    converters -> StaticResource.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:AgentNotch.App.UI">

    <!-- ===================== Converters ===================== -->
    <ui:NullToVisibilityConverter x:Key="NullToVisibility"/>
    <ui:StringToVisibilityConverter x:Key="StringToVisibility"/>
    <ui:CollectionToVisibilityConverter x:Key="CollectionToVisibility"/>
    <ui:GreaterThanOneToVisibilityConverter x:Key="GreaterThanOneToVisibility"/>
    <ui:SessionStateConverter x:Key="SessionState"/>
    <ui:SessionTitleConverter x:Key="SessionTitle"/>
    <ui:SessionSubtitleConverter x:Key="SessionSubtitle"/>
    <ui:SessionTokensConverter x:Key="SessionTokens"/>
    <ui:SessionAgentIconConverter x:Key="SessionAgentIcon"/>
    <ui:SessionStatusIconConverter x:Key="SessionStatusIcon"/>
    <ui:SessionStatusBrushConverter x:Key="SessionStatusBrush"/>
    <ui:AgentIconConverter x:Key="AgentIcon"/>
    <ui:StateKindIconConverter x:Key="StateKindIcon"/>
    <ui:StateKindBrushConverter x:Key="StateKindBrush"/>
    <ui:SessionBrandConverter x:Key="SessionBrand"/>
    <ui:SessionHostConverter x:Key="SessionHost"/>
    <ui:SessionAgeConverter x:Key="SessionAge"/>
    <ui:UsageSeverityBrushConverter x:Key="UsageSeverityBrush"/>
    <ui:ToastBrushConverter x:Key="ToastBrush"/>
    <ui:ToastGlyphConverter x:Key="ToastGlyph"/>
    <ui:BoolToCollapsedConverter x:Key="BoolToCollapsed"/>
    <ui:EqualsParamConverter x:Key="EqualsParam"/>
    <ui:StateVisibilityConverter x:Key="StateVisibility"/>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- Console theme only (see ConsoleConverters.cs for why its rules differ). -->
    <ui:AgentInkConverter x:Key="AgentInk"/>
    <ui:SessionAgentInkConverter x:Key="SessionAgentInk"/>
    <ui:SessionAgentNameConverter x:Key="SessionAgentName"/>
    <ui:SessionGlyphConverter x:Key="SessionGlyph"/>
    <ui:SessionGlyphInkConverter x:Key="SessionGlyphInk"/>
    <ui:SessionActivityInkConverter x:Key="SessionActivityInk"/>
    <ui:SessionRowBgConverter x:Key="SessionRowBg"/>
    <ui:ShellGlyphConverter x:Key="ShellGlyph"/>
    <ui:ShellInkConverter x:Key="ShellInk"/>
    <ui:UsageRemainingConverter x:Key="UsageRemaining"/>
    <ui:UsageSpecBrushConverter x:Key="UsageSpecBrush"/>
    <ui:TrackedConverter x:Key="Tracked"/>
    <ui:ThemeVisibilityConverter x:Key="ThemeVisibility"/>
    <ui:DiffSignConverter x:Key="DiffSign"/>
    <ui:DiffNumberConverter x:Key="DiffNumber"/>
    <ui:PromptKickerConverter x:Key="PromptKicker"/>
    <ui:OptionKeyConverter x:Key="OptionKey"/>
    <ui:BoolEqualsParamConverter x:Key="BoolEqualsParam"/>
    <ui:PromptVerbConverter x:Key="PromptVerb"/>
    <ui:PromptTargetConverter x:Key="PromptTarget"/>

    <!-- Chip on a session row: which agent, and which app it runs in. -->
    <Style x:Key="RowChipStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource KbdBgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource KbdBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource ChipCornerRadius}"/>
        <Setter Property="Padding" Value="6,1"/>
        <Setter Property="Margin" Value="4,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="RowChipTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <!-- ===================== Keyboard chips ===================== -->
    <Style x:Key="KbdChipBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource KbdBgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource KbdBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource ChipCornerRadius}"/>
        <Setter Property="Padding" Value="5,1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="KbdChipTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <Style x:Key="KbdChipOnLightBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource KbdOnLightBgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource KbdOnLightBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource ChipCornerRadius}"/>
        <Setter Property="Padding" Value="5,1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="KbdChipOnLightTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{DynamicResource KbdOnLightFgBrush}"/>
    </Style>

    <!-- ===================== Buttons ===================== -->
    <!-- Deny carries a border brush so the console theme can render it as an
         outline while the island theme keeps a filled slug (border = transparent). -->
    <Style x:Key="DenyButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <!-- The shadow layer is a no-op outside Atari (transparent, zero offset). -->
                    <Grid>
                        <Border IsHitTestVisible="False" Margin="{DynamicResource HardShadowOffset}"
                                CornerRadius="{DynamicResource ButtonCornerRadius}"
                                Background="{DynamicResource HardShadowBrush}"/>
                        <Border x:Name="bd" Background="{DynamicResource BtnDenyBgBrush}"
                                BorderBrush="{DynamicResource BtnDenyBorderBrush}"
                                BorderThickness="{DynamicResource CardBorderThickness}"
                                CornerRadius="{DynamicResource ButtonCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BtnDenyHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BtnDenyPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AllowButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource BtnAllowFgBrush}"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Border IsHitTestVisible="False" Margin="{DynamicResource HardShadowOffset}"
                                CornerRadius="{DynamicResource ButtonCornerRadius}"
                                Background="{DynamicResource HardShadowBrush}"/>
                        <Border x:Name="bd" Background="{DynamicResource BtnAllowBgBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="{DynamicResource OutlineThickness}"
                                CornerRadius="{DynamicResource ButtonCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BtnAllowHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource BtnAllowPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OptionButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Border IsHitTestVisible="False" Margin="{DynamicResource HardShadowOffset}"
                                CornerRadius="{DynamicResource ButtonCornerRadius}"
                                Background="{DynamicResource HardShadowBrush}"/>
                        <Border x:Name="bd" Background="{DynamicResource OptionBgBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="{DynamicResource OutlineThickness}"
                                CornerRadius="{DynamicResource ButtonCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource OptionHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource OptionPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="Transparent" Padding="4,2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== Settings controls ===================== -->
    <!-- iOS-style toggle switch (ToggleButton). IsChecked drives the knob + track.
         The knob is a Border, not an Ellipse, so the console theme's zero radius
         turns it into a square block instead of forcing a circle. -->
    <Style x:Key="ToggleSwitchStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="track" Width="40" Height="22"
                            CornerRadius="{DynamicResource PillCornerRadius}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="{DynamicResource OutlineThickness}"
                            Background="{DynamicResource OptionBgBrush}">
                        <!-- One inset on every side, from the palette. It has to shrink
                             with the track's outline: a 2px outline leaves an 18px
                             interior, so a fixed 3px end gap next to a 1px top/bottom
                             gap made the knob look like it stopped short of the end. -->
                        <Border x:Name="thumb" Width="16" Height="16"
                                CornerRadius="{DynamicResource PillCornerRadius}"
                                HorizontalAlignment="Left" Margin="{DynamicResource ToggleKnobInset}"
                                Background="{DynamicResource TextSecondaryBrush}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{DynamicResource StatusFinishedBrush}"/>
                            <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="thumb" Property="Background" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented picker cell (RadioButton). Checked cell fills; the group is one pill.
         The checked pair is its own token so the console theme can invert it
         (white block, black label) instead of merely lifting the fill. -->
    <Style x:Key="SegmentRadioStyle" TargetType="{x:Type RadioButton}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border x:Name="bd" Background="Transparent"
                            CornerRadius="{DynamicResource ButtonCornerRadius}" Padding="12,4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource OptionHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SegmentCheckedBgBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SegmentCheckedFgBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Slim dark scrollbars ===================== -->
    <Style x:Key="ScrollPageButtonStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Rectangle Fill="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="{DynamicResource ScrollThumbBrush}"
                            CornerRadius="{DynamicResource ChipCornerRadius}" Margin="1"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
        <Grid Background="Transparent" Width="8">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollPageButtonStyle}"
                                  Command="{x:Static ScrollBar.PageUpCommand}"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollPageButtonStyle}"
                                  Command="{x:Static ScrollBar.PageDownCommand}"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
        <Grid Background="Transparent" Height="8">
            <Track x:Name="PART_Track" IsDirectionReversed="False" Orientation="Horizontal">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollPageButtonStyle}"
                                  Command="{x:Static ScrollBar.PageLeftCommand}"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollPageButtonStyle}"
                                  Command="{x:Static ScrollBar.PageRightCommand}"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="8"/>
                <Setter Property="MinHeight" Value="8"/>
                <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
