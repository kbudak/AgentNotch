<UserControl x:Class="AgentNotch.App.UI.SessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:AgentNotch.App.UI"
             Focusable="False">

    <!-- DataContext: MainViewModel (inherited from OverlayWindow) -->
    <StackPanel>

        <!-- Empty state -->
        <TextBlock Text="No active agents — waiting."
                   FontSize="11" Margin="6,4,6,4"
                   Foreground="{DynamicResource TextTertiaryBrush}">
            <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Sessions.Count, FallbackValue=0}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Session rows -->
        <ItemsControl ItemsSource="{Binding Sessions}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- The bottom hairline is what turns the console theme's rows into
                         one table; the island theme paints it transparent. It eats the
                         last pixel of padding rather than adding one, so row height is
                         identical either way. -->
                    <!-- The row margin moved to this wrapper so the shadow layer and
                         the row share one slot. The shadow is a no-op outside Atari. -->
                    <Grid Margin="{DynamicResource SessionRowMargin}">
                    <Border IsHitTestVisible="False" Margin="{DynamicResource HardShadowOffset}"
                            CornerRadius="{DynamicResource ButtonCornerRadius}"
                            Background="{DynamicResource HardShadowBrush}"/>
                    <Border x:Name="Row" Background="{DynamicResource SessionRowBgBrush}"
                            CornerRadius="{DynamicResource ButtonCornerRadius}"
                            BorderBrush="{DynamicResource RowSeparatorBrush}"
                            BorderThickness="{DynamicResource SessionRowBorderThickness}"
                            Padding="{DynamicResource SessionRowPadding}" Cursor="Hand"
                            MouseLeftButtonDown="OnSessionRowClick">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Background" Value="{DynamicResource SessionRowBgBrush}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Lead: the AGENT mark (Claude invader / Codex / Gemini) and,
                                 to its right, a small STATUS glyph — a pixel ring that spins
                                 while working, "?" when it needs you, "✓" when done. Both are
                                 tinted by the state colour (blue / orange / green). -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="1,0,10,0">
                                <Grid VerticalAlignment="Center">
                                    <Path Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center"
                                          Visibility="{DynamicResource BareVisibility}"
                                          Data="{Binding Converter={StaticResource SessionAgentIcon}}"
                                          Fill="{Binding Converter={StaticResource SessionStatusBrush}}"/>
                                    <Border Width="28" Height="28"
                                            Visibility="{DynamicResource TiledVisibility}"
                                            CornerRadius="{DynamicResource ChipCornerRadius}"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="2"
                                            Background="{Binding Converter={StaticResource SessionStatusBrush}}">
                                        <Path Width="15" Height="15" Stretch="Uniform"
                                              Data="{Binding Converter={StaticResource SessionAgentIcon}}"
                                              Fill="{DynamicResource TileInkBrush}"/>
                                    </Border>
                                </Grid>
                                <Grid Width="13" Height="13" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <!-- Working: the pixel-dot comet spinner. -->
                                    <ui:PixelSpinner
                                        Foreground="{Binding Converter={StaticResource SessionStatusBrush}}"
                                        Visibility="{Binding Converter={StaticResource StateVisibility}, ConverterParameter=working}"/>
                                    <!-- Otherwise the static "?" / "✓" glyph. -->
                                    <Path Stretch="Uniform"
                                          Data="{Binding Converter={StaticResource SessionStatusIcon}}"
                                          Fill="{Binding Converter={StaticResource SessionStatusBrush}}"
                                          Tag="{Binding Converter={StaticResource SessionState}}"
                                          Visibility="{Binding Converter={StaticResource StateVisibility}, ConverterParameter=!working}">
                                        <Path.Style>
                                            <Style TargetType="{x:Type Path}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                                                 Value="needsyou">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="RowAlert">
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                     From="1" To="0.35" Duration="0:0:0.6"
                                                                                     AutoReverse="True" RepeatBehavior="Forever"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="RowAlert"/>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Grid>
                            </StackPanel>

                            <!-- Title + subtitle -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Converter={StaticResource SessionTitle}}"
                                           FontSize="13" FontWeight="{DynamicResource TitleFontWeight}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Converter={StaticResource SessionSubtitle}}"
                                           FontSize="12" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- Finished sessions advertise that the row is clickable. -->
                                <TextBlock Text="Done — click to jump" FontSize="10" Margin="0,2,0,0"
                                           Foreground="{DynamicResource StatusFinishedBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Converter={StaticResource SessionState}}"
                                                             Value="finished">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- Where it runs: brand chip + host app chip + age -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock Text="{Binding Converter={StaticResource SessionTokens}}"
                                           FontSize="10" Margin="0,0,2,0"
                                           FontFamily="{DynamicResource MonoFontFamily}"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}" BasedOn="{StaticResource RowChipStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Converter={StaticResource SessionBrand}}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Converter={StaticResource SessionBrand}}"
                                               Style="{StaticResource RowChipTextStyle}"/>
                                </Border>
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}" BasedOn="{StaticResource RowChipStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Converter={StaticResource SessionHost}}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Converter={StaticResource SessionHost}}"
                                               Style="{StaticResource RowChipTextStyle}"/>
                                </Border>
                                <TextBlock Text="{Binding Converter={StaticResource SessionAge}}"
                                           FontSize="10" Margin="6,0,0,0"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Jump glyph (revealed on hover) -->
                            <TextBlock Grid.Column="3" x:Name="JumpGlyph" Text="↗"
                                       FontSize="12" Margin="8,0,2,0" Opacity="0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    </Grid>
                    <DataTemplate.Triggers>
                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                            <Setter TargetName="JumpGlyph" Property="Opacity" Value="1"/>
                        </Trigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </StackPanel>
</UserControl>
