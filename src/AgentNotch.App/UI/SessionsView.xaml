<UserControl x:Class="AgentNotch.App.UI.SessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">

    <!-- DataContext: MainViewModel (inherited from OverlayWindow) -->
    <StackPanel>

        <!-- Empty state -->
        <TextBlock Text="No active agents — waiting."
                   FontSize="11" Margin="6,4,6,4"
                   Foreground="{StaticResource TextTertiaryBrush}">
            <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Sessions.Count, FallbackValue=0}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Session rows -->
        <ItemsControl ItemsSource="{Binding Sessions}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="Row" Background="Transparent" CornerRadius="8"
                            Padding="10,7" Margin="0,2,0,0" Cursor="Hand"
                            MouseLeftButtonUp="OnSessionRowClick">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource CardHoverBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Status mark: the SHAPE says the state (spinner = working,
                                 "?" = needs you, "✓" = done), the FILL says its colour
                                 (blue / orange / green). Working spins; needs-you pulses. -->
                            <Path Grid.Column="0" Width="16" Height="16" Stretch="Uniform"
                                  VerticalAlignment="Center" Margin="1,0,10,0"
                                  RenderTransformOrigin="0.5,0.5"
                                  Data="{Binding Converter={StaticResource SessionStatusIcon}}"
                                  Fill="{Binding Converter={StaticResource SessionStatusBrush}}"
                                  Tag="{Binding Converter={StaticResource SessionState}}">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Path.RenderTransform>
                                <Path.Style>
                                    <Style TargetType="{x:Type Path}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                                         Value="working">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="RowSpin">
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                From="0" To="360" Duration="0:0:1.1"
                                                                RepeatBehavior="Forever"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="RowSpin"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                                         Value="needsyou">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="RowAlert">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="1" To="0.35" Duration="0:0:0.6"
                                                                             AutoReverse="True" RepeatBehavior="Forever"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="RowAlert"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>

                            <!-- Title + subtitle -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Converter={StaticResource SessionTitle}}"
                                           FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Converter={StaticResource SessionSubtitle}}"
                                           FontSize="12" Margin="0,2,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- Finished sessions advertise that the row is clickable. -->
                                <TextBlock Text="Done — click to jump" FontSize="10" Margin="0,2,0,0"
                                           Foreground="{StaticResource StatusFinishedBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Converter={StaticResource SessionState}}"
                                                             Value="finished">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- Where it runs: brand chip + host app chip + age -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock Text="{Binding Converter={StaticResource SessionTokens}}"
                                           FontSize="10" Margin="0,0,2,0"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}" BasedOn="{StaticResource RowChipStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Converter={StaticResource SessionBrand}}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Converter={StaticResource SessionBrand}}"
                                               Style="{StaticResource RowChipTextStyle}"/>
                                </Border>
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}" BasedOn="{StaticResource RowChipStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Converter={StaticResource SessionHost}}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Converter={StaticResource SessionHost}}"
                                               Style="{StaticResource RowChipTextStyle}"/>
                                </Border>
                                <TextBlock Text="{Binding Converter={StaticResource SessionAge}}"
                                           FontSize="10" Margin="6,0,0,0"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Jump glyph (revealed on hover) -->
                            <TextBlock Grid.Column="3" x:Name="JumpGlyph" Text="↗"
                                       FontSize="12" Margin="8,0,2,0" Opacity="0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource CardHoverBrush}"/>
                            <Setter TargetName="JumpGlyph" Property="Opacity" Value="1"/>
                        </Trigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </StackPanel>
</UserControl>
